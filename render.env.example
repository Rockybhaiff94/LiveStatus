PORT=4000
NODE_ENV=production
# Note: On Render/IPv4 hosts, use the Supabase connection pooler URL (aws-0-REGION.pooler.supabase.com)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD_HERE@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
TOKEN_ENCRYPTION_KEY=generate-a-64-hex-char-key-with-openssl-rand-hex-32
HMAC_STATE_SECRET=generate-a-64-hex-char-key-with-openssl-rand-hex-32
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.mcast.fun/v1/oauth/callback
MCAST_WEB_URL=https://mcast.fun
CORS_ORIGIN=https://mcast.fun
