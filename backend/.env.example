# MCast Central Backend Environment Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database Connection URL
DATABASE_URL=postgres://mcast_user:password@localhost:5432/mcast

# AES-256-GCM Refresh Token Encryption Key (Must be exactly 32 bytes / 64 hex characters)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret for HMAC-SHA256 OAuth State and Session Signatures
HMAC_STATE_SECRET=mcast_super_secure_state_secret_change_in_production

# Google Cloud OAuth 2.0 Credentials (Configured ONCE centrally on MCast Backend)
# Requires YouTube Data API v3 enabled in Google Cloud Console
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.mcast.fun/v1/oauth/callback

# MCast Public Web Frontend URL
MCAST_WEB_URL=https://mcast.fun

# CORS Allowed Origins (Comma separated or *)
CORS_ORIGIN=https://mcast.fun,http://localhost:3000
